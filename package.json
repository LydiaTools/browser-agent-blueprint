{
  "name": "browser-agent-blueprint",
  "version": "0.1.1",
  "private": true,
  "description": "Original modular browser-agent prompts with reproducible checkpoint and risk-gate demos.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/policy.test.cjs tests/builder.test.cjs tests/skill.test.cjs",
    "test:browser": "node --test tests/analytics-consent.test.cjs",
    "assemble": "node scripts/assemble.cjs",
    "metrics": "node scripts/metrics.cjs",
    "demo": "node demo/run.cjs",
    "demo:prepare": "node demo/run.cjs --phase prepare",
    "demo:resume": "node demo/run.cjs --phase resume",
    "demo:crash-boundaries": "node demo/crash-boundaries.cjs",
    "build:builder": "node scripts/build-builder.cjs",
    "test:builder": "node tests/builder-browser.cjs",
    "build:skill": "node scripts/build-skill.cjs",
    "test:skill-install": "node tests/skill-install.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
